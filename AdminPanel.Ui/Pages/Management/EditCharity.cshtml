
 @page

@model AdminPanel.Ui.Pages.Management.EditCharityModel
@using System.Text.Json
@using AdminPanel.Core.Enums

@{
    ViewData["Title"] = "ویرایش خیریه";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                ویرایش اطلاعات خیریه:
                @(Model.Input?.Name ?? "-")
            </h5>

            <a asp-page="./Charities" class="btn btn-label-secondary">
                <i class="ti ti-arrow-right me-1"></i>
                بازگشت به لیست
            </a>

        </div>


        <div class="card-body">

            <form method="post" enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                @* <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div> *@

                <div asp-validation-summary="ModelOnly"
     class="alert alert-danger"
     role="alert">
</div>



                <input type="hidden" asp-for="Input.Id" />


                <div class="row g-3">


                    <!-- نام خیریه -->
                    <div class="col-md-6">

                        <label asp-for="Input.Name"
                               class="form-label">
                            نام خیریه
                        </label>

                        <input asp-for="Input.Name"
                               class="form-control" />

                        <span asp-validation-for="Input.Name"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- وب سایت -->
                    <div class="col-md-6">

                        <label asp-for="Input.Website"
                               class="form-label">
                            وبسایت
                        </label>

                        <input asp-for="Input.Website"
                               class="form-control"
                               style="direction:ltr;" />

                        <span asp-validation-for="Input.Website"
                              class="text-danger">
                        </span>

                    </div>



                    <!-- دسته بندی ها -->

                    <div class="col-12 mb-4">

                        <div class="d-flex justify-content-between align-items-center mb-2">

                            <label class="form-label fw-bold mb-0">
                                دسته‌بندی‌ها
                            </label>

                            <span class="text-muted small">
                                دسته‌بندی‌های فعلی خیریه
                            </span>

                        </div>



                        <div class="border rounded p-3 bg-light">


                            <div id="currentCategories"
                                 class="d-flex flex-wrap gap-2">


                                @if (Model.Input.CategoryIds.Any())
                                {

                                    foreach (var categoryId in Model.Input.CategoryIds)
                                    {
                                        var category =
                                        Model.AllCategories
                                        .FirstOrDefault(x => x.Id == categoryId);


                                        if (category != null)
                                        {

                                            <div class="badge bg-primary d-flex align-items-center gap-2 p-2 category-item"
                                                 data-category-id="@category.Id">


                                                <span>
                                                    @category.Name
                                                </span>


                                                <button type="button"
                                                        class="btn-close btn-close-white remove-current-category">
                                                </button>


                                                <input type="hidden"
                                                       name="Input.CategoryIds"
                                                       value="@category.Id" />

                                            </div>

                                        }
                                    }

                                }
                                else
                                {

                                    <span id="noCategoryMessage"
                                          class="text-muted">
                                        هنوز دسته‌بندی ثبت نشده است.
                                    </span>

                                }


                            </div>


                        </div>


                    </div>



                    <div class="col-md-6">

                        <label class="form-label">
                            افزودن دسته‌بندی جدید
                        </label>


                        <select id="categorySelect"
                                class="form-select">


                            <option value="">
                                -- انتخاب دسته‌بندی --
                            </option>


                            @foreach(var category in Model.AllCategories)
                            {

                                <option value="@category.Id">
                                    @category.Name
                                </option>

                            }


                        </select>



                        <button type="button"
                                id="addCategoryBtn"
                                class="btn btn-outline-primary mt-2">

                            افزودن دسته‌بندی

                        </button>


                    </div>

                                                    <!-- شبکه های اجتماعی -->

                    <div class="col-12 mb-4">

                        <div class="d-flex justify-content-between align-items-center mb-2">

                            <label class="form-label fw-bold mb-0">
                                شبکه‌های اجتماعی
                            </label>


                            <button type="button"
                                    id="addSocialBtn"
                                    class="btn btn-outline-primary btn-sm">

                                <i class="bi bi-plus-lg"></i>
                                افزودن شبکه اجتماعی

                            </button>

                        </div>



                        <div id="socialRows">


                            @for (var i = 0; i < Model.Input.SocialMedias.Count; i++)
                            {

                                var social = Model.Input.SocialMedias[i];


                                <div class="card mb-2 social-row">

                                    <div class="card-body d-flex gap-2 align-items-end">


                                       <input type="hidden"
       class="social-id"
       name="Input.SocialMedias[@i].Id"
       value="@social.Id" />




                                               <input type="hidden"
       class="social-name"
       name="Input.SocialMedias[@i].SocialName"
       value="@social.SocialName" />

                                        <div class="flex-grow-1">


                                            <label class="form-label">
                                                شبکه اجتماعی
                                            </label>


                                            <select class="form-select social-type"
                                                    name="Input.SocialMedias[@i].SocialId">


                                                @foreach(var type in Model.SocialTypes)
                                                {

                                                   <option value="@type.Id"
                                                    selected="@(type.Id == social.SocialId ? "selected" : null)">
                                                    @type.Name
                                                    </option>


                                                }


                                            </select>


                                        </div>




                                        <div class="flex-grow-1">


                                            <label class="form-label">
                                                آدرس / شناسه
                                            </label>


                                            <input class="form-control social-value"
                                                   name="Input.SocialMedias[@i].Value"
                                                   value="@social.Value" />

                                        </div>



                                        <button type="button"
                                                class="btn btn-outline-danger remove-social">

                                            حذف

                                        </button>


                                    </div>

                                </div>

                            }


                        </div>



                        @if (!Model.Input.SocialMedias.Any())
                        {

                            <span id="noSocialMessage"
                                  class="text-muted">

                                هیچ شبکه اجتماعی ثبت نشده است.

                            </span>

                        }


                    </div>





                    <!-- تصاویر -->

                    <div class="col-md-6">


                        <label class="form-label">
                            لوگو
                        </label>



                        <div class="border rounded p-3 text-center">



                            <img id="logoPreviewImg"
                                 src="@Model.CurrentLogoUrl"
                                 class="img-thumbnail @(string.IsNullOrWhiteSpace(Model.CurrentLogoUrl) ? "d-none" : "")"
                                 style="width:140px;height:140px;object-fit:cover;"
                                 alt="لوگو" />



                            <div id="logoPlaceholder"
                                 class="text-muted py-4 @(string.IsNullOrWhiteSpace(Model.CurrentLogoUrl) ? "" : "d-none")">

                                <i class="ti ti-photo fs-1"></i>

                                <div>
                                    لوگویی ثبت نشده است
                                </div>

                            </div>




                            <input asp-for="Input.LogoFile"
                                   id="logoFileInput"
                                   type="file"
                                   accept="image/*"
                                   class="d-none" />



                            <div class="mt-3 d-flex justify-content-center gap-2">


                                <button type="button"
                                        id="editLogoBtn"
                                        class="btn btn-outline-primary btn-sm">

                                    <i class="ti ti-pencil"></i>
                                    ویرایش لوگو

                                </button>



                                <button type="button"
                                        id="removeLogoBtn"
                                        class="btn btn-outline-danger btn-sm">

                                    <i class="ti ti-trash"></i>
                                    حذف لوگو

                                </button>


                            </div>


                        </div>



                        <small class="text-muted">
                            در صورت انتخاب فایل جدید، لوگوی قبلی جایگزین می‌شود.
                        </small>


                    </div>





                    <!-- بنر -->


                    <div class="col-md-6">


                        <label class="form-label">
                            بنر
                        </label>



                        <div class="border rounded p-3 text-center">



                            <img id="bannerPreviewImg"
                                 src="@Model.CurrentBannerUrl"
                                 class="img-fluid rounded @(string.IsNullOrWhiteSpace(Model.CurrentBannerUrl) ? "d-none" : "")"
                                 style="width:100%;height:160px;object-fit:cover;"
                                 alt="بنر" />



                            <div id="bannerPlaceholder"
                                 class="text-muted py-5 @(string.IsNullOrWhiteSpace(Model.CurrentBannerUrl) ? "" : "d-none")">


                                <i class="ti ti-photo fs-1"></i>


                                <div>
                                    بنری ثبت نشده است
                                </div>


                            </div>




                            <input asp-for="Input.BannerFile"
                                   id="bannerFileInput"
                                   type="file"
                                   accept="image/*"
                                   class="d-none" />




                            <div class="mt-3 d-flex justify-content-center gap-2">


                                <button type="button"
                                        id="editBannerBtn"
                                        class="btn btn-outline-primary btn-sm">


                                    <i class="ti ti-pencil"></i>
                                    ویرایش بنر


                                </button>




                                <button type="button"
                                        id="removeBannerBtn"
                                        class="btn btn-outline-danger btn-sm">


                                    <i class="ti ti-trash"></i>
                                    حذف بنر


                                </button>


                            </div>


                        </div>



                        <small class="text-muted">
                            در صورت انتخاب فایل جدید، بنر قبلی جایگزین می‌شود.
                        </small>


                    </div>





                    <!-- اطلاعات تکمیلی -->


                    <div class="col-md-6">


                        <label asp-for="Input.Telephone"
                               class="form-label">

                            تلفن ثابت

                        </label>


                        <input asp-for="Input.Telephone"
                               class="form-control"
                               style="direction:ltr;" />


                    </div>





                    <div class="col-md-6">


                        <label asp-for="Input.ManagerName"
                               class="form-label">

                            نام مدیر

                        </label>


                        <input asp-for="Input.ManagerName"
                               class="form-control" />


                    </div>




                    <div class="col-md-6">


                        <label asp-for="Input.ContactName"
                               class="form-label">

                            نام مسئول (مخاطب)

                        </label>


                        <input asp-for="Input.ContactName"
                               class="form-control" />


                    </div>





                    <div class="col-md-6">


                        <label asp-for="Input.ContactPhone"
                               class="form-label">

                            تلفن مسئول

                        </label>


                        <input asp-for="Input.ContactPhone"
                               class="form-control"
                               style="direction:ltr;" />


                    </div>





                    <div class="col-12">


                        <label asp-for="Input.Address"
                               class="form-label">

                            آدرس

                        </label>


                        <textarea asp-for="Input.Address"
                                  class="form-control"
                                  rows="2"></textarea>


                    </div>





                    <div class="col-12">


                        <label asp-for="Input.Description"
                               class="form-label">

                            توضیحات

                        </label>


                        <textarea asp-for="Input.Description"
                                  class="form-control"
                                  rows="3"></textarea>


                    </div>




                    <div class="col-12 text-end mt-4">


                        @* <button type="submit"
                                class="btn btn-primary px-5">

                            <i class="ti ti-device-floppy me-1"></i>

                            ذخیره تغییرات

                        </button> *@


                      @* محدود کردن سطح دسترسی charityuser *@

                        @if (User.FindFirst("UserType")?.Value != ((int)AdminUserType.CharityUser).ToString())
{
    <button type="submit" class="btn btn-primary px-5">
        <i class="ti ti-device-floppy me-1"></i>
        ذخیره تغییرات
    </button>
}
else
{
    <div class="alert alert-warning">
        شما فقط دسترسی مشاهده اطلاعات را دارید.
    </div>
}




                        <a asp-page="./Charities"
                           class="btn btn-label-secondary">

                            انصراف

                        </a>


                    </div>


                </div>

            </form>

        </div>

    </div>

</div>


  @section Scripts {

    @* <partial name="_ValidationScriptsPartial" /> *@




    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>

        window.socialTypes =
        @Html.Raw(JsonSerializer.Serialize(Model.SocialTypes));


    </script>


    <script src="~/assets/js/CharityEdit.js"></script>

}