@page "{id:int}"
@model AdminPanel.Ui.Pages.Management.CampaignDetailsModel
@{
    ViewData["Title"] = "جزئیات کمپین";
}




<meta name="access-token" content="@User.FindFirst("AccessToken")?.Value" />

<script>
    const apiBaseUrl = "https://localhost:7209";
</script>



@* Send data to client script file *@
<input type="hidden" id="campaign-id" value="@Model.CampaignId" />
<meta name="user-role" content="@User.FindFirst("UserType")?.Value" />





<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">جزئیات کمپین</h4>
    <a asp-page="/Management/Campaigns" class="btn btn-outline-secondary">
        بازگشت به فهرست کمپین‌ها
    </a>
</div>




<div class="card-body">
    <div class="row g-4">
        <!-- بنر کمپین -->
        <div class="col-12 text-center mb-3">
            <label class="form-label text-muted d-block text-start">تصویر بنر کمپین</label>
            <div class="d-inline-block border rounded p-2 bg-light">
                <img id="campaign-banner" src="/assets/img/illustrations/page-misc-error.png" alt="بنر کمپین" class="img-fluid rounded" style="max-height: 250px; object-fit: cover; display: none;" />
                <div id="campaign-banner-placeholder" class="text-muted p-4"><i class="ti ti-image ti-lg me-1"></i> تصویری برای این کمپین ثبت نشده است.</div>
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label text-muted">عنوان کمپین</label>
            <div class="form-control-plaintext fw-bold" id="campaign-title">در حال بارگذاری...</div>
        </div>

        <div class="col-md-6">
            <label class="form-label text-muted">وضعیت فعلی</label>
            <div class="form-control-plaintext" id="campaign-status">-</div>
        </div>

        <div class="col-md-6">
            <label class="form-label text-muted">خیریه</label>
            <div class="form-control-plaintext" id="campaign-charity">-</div>
        </div>

        <div class="col-md-6">
            <label class="form-label text-muted">دسته‌بندی</label>
            <div class="form-control-plaintext" id="campaign-categories">-</div>
        </div>

        <!-- فیلدهای جدید اضافه شده -->
        <div class="col-md-6">
            <label class="form-label text-muted">شهر</label>
            <div class="form-control-plaintext" id="campaign-city">-</div>
        </div>

        <div class="col-md-6">
            <label class="form-label text-muted">مبلغ مورد نیاز (هدف)</label>
            <div class="form-control-plaintext fw-bold text-success" id="campaign-target-amount">-</div>
        </div>

        <div class="col-md-6">
            <label class="form-label text-muted">تاریخ شروع</label>
            <div class="form-control-plaintext" id="campaign-start-date">-</div>
        </div>

        <div class="col-md-6">
            <label class="form-label text-muted">تاریخ پایان</label>
            <div class="form-control-plaintext" id="campaign-end-date">-</div>
        </div>

        <div class="col-12">
            <label class="form-label text-muted">توضیحات</label>
            <div class="form-control-plaintext" id="campaign-description">-</div>
        </div>
    </div>
</div>



@* Status management section *@
<div class="card d-none" id="admin-actions-card">
    <div class="card-header">
        <h5 class="mb-0">مدیریت وضعیت کمپین</h5>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2" id="status-buttons-container">
        </div>
    </div>
</div>




@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/assets/js/campaign-details.js"></script>
}
