<!-- در ابتدای بدنه فایل یا داخل فرم ها -->
@Html.AntiForgeryToken()

<!-- Modal for Edit -->
<div class="modal fade" id="editCharityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3 p-md-5">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <h3 class="mb-2">ویرایش اطلاعات خیریه</h3>
                </div>
                <form id="formEditCharity" class="row g-3">
                    <input type="hidden" id="editCharityId" name="Id" />
                    <div class="col-12 col-md-6">
                        <label class="form-label">نام خیریه</label>
                        <input type="text" id="editName" name="Name" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">تلفن</label>
                        <input type="text" id="editPhone" name="Telephone" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">وبسایت</label>
                        <input type="text" id="editWebsite" name="Website" class="form-control" />
                    </div>
                    <!-- سایر فیلدها را اینجا اضافه کن -->

                    <div class="col-12 text-center mt-4">
                        <button type="submit" class="btn btn-primary me-sm-3 me-1">ثبت تغییرات</button>
                        <button type="reset" class="btn btn-label-secondary" data-bs-dismiss="modal">انصراف</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



