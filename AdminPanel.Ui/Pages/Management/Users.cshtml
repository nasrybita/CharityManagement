      content="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" /> *@

<script>
    window.isCurrentUserRoot = @isRoot.ToString().ToLowerInvariant();
    window.apiBaseUrl = "https://localhost:7209";
    window.currentUserId = @(
        User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        );
