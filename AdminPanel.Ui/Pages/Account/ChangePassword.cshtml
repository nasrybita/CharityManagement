@page
@model AdminPanel.Ui.Pages.Account.ChangePasswordModel
@{
    Layout = "_LayoutChangePassword";
}



@using System.Security.Claims
@{
    var token = User.FindFirst("AccessToken")?.Value;
}



<form id="changePasswordForm">
    @* فیلد مخفی برای نگه داشتن ID کاربر *@
    <input type="hidden" id="userId" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />

    @* اگر کاربر CharityUser بود، فیلد رمز فعلی رو نشون بده *@
    @if (Model.RequireCurrentPassword)
    {
        <div class="mb-3 form-password-toggle">
            <label class="form-label" for="currentPassword">رمز عبور فعلی</label>
            <div class="input-group input-group-merge">
                <input type="password" id="currentPassword" class="form-control" dir="ltr" placeholder="············" />
                <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
            </div>
        </div>
    }

    @* فیلد رمز جدید *@
    <div class="mb-3 form-password-toggle">
        <label class="form-label" for="newPassword">رمز عبور جدید</label>
        <div class="input-group input-group-merge">
            <input type="password" id="newPassword" class="form-control" dir="ltr" placeholder="············" />
            <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
        </div>
    </div>

    @* فیلد تکرار رمز جدید *@
    <div class="mb-3 form-password-toggle">
        <label class="form-label" for="confirmPassword">تکرار رمز عبور جدید</label>
        <div class="input-group input-group-merge">
            <input type="password" id="confirmPassword" class="form-control" dir="ltr" placeholder="············" />
            <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
        </div>
    </div>

    <button type="button" id="btnSubmitChange" class="btn btn-primary d-grid w-100 mb-3">تغییر رمز عبور</button>

    <div class="text-center">
        <a href="/Index" class="d-flex align-items-center justify-content-center">
            <i class="ti ti-chevron-right scaleX-n1-rtl me-1"></i>
            بازگشت به پنل
        </a>
    </div>
</form>

@section Scripts {
    <!-- کتابخانه SweetAlert2 برای پیام‌های زیبا -->

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            const token = '@token';

            $('#btnSubmitChange').on('click', function (e) {
                e.preventDefault();

                const userId = $('#userId').val();
                const data = {
                    currentPassword: $('#currentPassword').val() || "",
                    newPassword: $('#newPassword').val(),
                    confirmPassword: $('#confirmPassword').val()
                };

                if (!data.newPassword || !data.confirmPassword) {
                    Swal.fire('خطا', 'لطفاً تمام فیلدها را پر کنید', 'error');
                    return;
                }

                if (data.newPassword !== data.confirmPassword) {
                    Swal.fire('خطا', 'رمز عبور جدید و تکرار آن با هم برابر نیستند', 'error');
                    return;
                }

                const $btn = $(this);
                $btn.prop('disabled', true).text('در حال ارسال...');

                $.ajax({
                    url: `https://localhost:7209/api/User/change-password/${userId}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    headers: {
                        'Authorization': 'Bearer ' + token
                    },
                    data: JSON.stringify(data),
                    success: function (response) {
                        if (response.hasError) {
                            Swal.fire('خطا', response.errorMessage, 'error');
                            $btn.prop('disabled', false).text('تغییر رمز عبور');
                        } else {
                            Swal.fire({
                                title: 'موفقیت‌آمیز',
                                text: 'رمز عبور شما با موفقیت تغییر کرد.',
                                icon: 'success',
                                confirmButtonText: 'تایید'
                            }).then(() => {
                                window.location.href = "/Index";
                            });
                        }
                    },
                    error: function (xhr) {
                        console.error(xhr);
                        Swal.fire('خطا', 'مشکلی در برقراری ارتباط با سرور رخ داده است', 'error');
                        $btn.prop('disabled', false).text('تغییر رمز عبور');
                    }
                });
            });
        });
    </script>

}
