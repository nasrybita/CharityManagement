@page
@model AdminPanel.Ui.Pages.Account.LoginModel
@{
    Layout = "/Pages/Shared/_LayoutLogin.cshtml";
}



<form id="formAuthentication" class="mb-3" method="POST">
    @* myTag *@
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div> 
    <div class="mb-3">
        <label for="email" class="form-label">ایمیل یا نام کاربری</label>
        <input type="text"
               class="form-control"
               id="email"
               asp-for="Input.UserName"
               placeholder="ایمیل یا نام کاربری خود را وارد نمایید"
               autofocus />
        @* myTag *@
        <span asp-validation-for="Input.UserName" class="text-danger"></span>
    </div>
    <div class="mb-3 form-password-toggle">
        <div class="d-flex justify-content-between">
            <label class="form-label" for="password">رمز عبور</label>
            <a href="auth-forgot-password-cover.html">
                <small>فراموشی رمز عبور؟</small>
            </a>
        </div>
        <div class="input-group input-group-merge">
            <input type="password"
                   id="password"
                   class="form-control"
                   asp-for="Input.Password"
                   placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                   aria-describedby="password" />
            <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
        </div>
        @* myTag *@
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="remember-me" />
            <label class="form-check-label" for="remember-me"> من را به خاطر بسپار </label>
        </div>

        @* <!-- لینک به صفحه تغییر رمز -->
        <a asp-page="/Account/ChangePassword">
            <small>تغییر رمز عبور؟</small>
        </a> *@

    </div>
    <button class="btn btn-primary d-grid w-100">ورود</button>
</form>


@* Prevent Sending Data to Server before Client-side Validation *@
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}